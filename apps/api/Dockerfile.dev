# 开发用镜像：容器内安装依赖 + 热更新
FROM node:22-alpine

# Prisma 在 alpine 需要 openssl
RUN apk add --no-cache openssl

RUN corepack enable && corepack prepare pnpm@10.13.1 --activate

WORKDIR /app

# 先拷贝清单，利用缓存
COPY package.json ./
COPY pnpm-lock.yaml ./
COPY prisma ./prisma

RUN pnpm install --frozen-lockfile --ignore-scripts

# 生成 Prisma Client（schema 已在上面拷入）
RUN pnpm prisma generate

# 其余源码由 docker-compose 挂载卷提供
COPY . .

EXPOSE 3000

# Deploy migrations before startup: COP also requires its sequence and SQL CHECKs.
# Existing db-push-only databases must be verified and baselined before upgrading.
# The named node_modules volume masks the image's dependencies. Reconcile it with
# the mounted lockfile and regenerate Prisma Client before compiling on each start.
CMD ["sh", "-c", "pnpm install --frozen-lockfile --ignore-scripts && pnpm prisma generate && pnpm prisma migrate deploy && pnpm db:seed:dev && exec pnpm start:dev"]
