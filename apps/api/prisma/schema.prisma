// 工单管理系统数据模型
// 详见 docs/01-设计文档.md 第 3 节
generator client {
  provider      = "prisma-client-js"
  // 只生成运行环境（alpine/musl）需要的查询引擎，不打包其它平台的副本
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ 枚举 ============
enum UserStatus {
  ACTIVE
  DISABLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  NEW
  ASSIGNED
  IN_PROGRESS
  PENDING
  RESOLVED
  CLOSED
  REOPENED
  CANCELLED
}

enum MessageType {
  REPLY // 公开回复
  NOTE // 内部备注
  SYSTEM // 系统事件
}

enum TicketParticipantRole {
  COLLABORATOR // 可参与处理讨论，但不是 SLA 主责人
  FOLLOWER // 仅关注动态与接收通知
}

enum HistoryAction {
  CREATE
  ASSIGN
  TRANSITION
  MESSAGE
  UPDATE
  ATTACH
}

// ============ 用户与权限（RBAC）============
// User 同时是 better-auth 的用户表：核心字段 name/email/emailVerified/image
// 由 better-auth 管理，密码存于 account 表；username/phone/status 为业务扩展。
model User {
  id               String     @id @default(cuid())
  name             String
  email            String     @unique
  emailVerified    Boolean    @default(false)
  twoFactorEnabled Boolean    @default(false)
  sessionEpoch     Int        @default(0) @map("session_epoch")
  image            String?
  // 业务扩展字段
  username         String?    @unique
  phone            String?
  // 勾选「设为默认联系方式」时存这里，下次建单自动带出。与 Ticket.contact 同结构
  defaultContact   Json?      @map("default_contact")
  status           UserStatus @default(ACTIVE)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  departmentId        String?
  department          Department?          @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  assets              Asset[]
  inventoryOperations InventoryOperation[]
  businessActivities  BusinessActivity[]
  businessAttachments BusinessAttachment[]

  // better-auth 关系
  sessions  Session[]
  accounts  Account[]
  twoFactor TwoFactor?

  // 业务关系
  roles                UserRole[]
  directoryIdentity    DirectoryIdentity?
  requestedTickets     Ticket[]               @relation("Requester")
  assignedTickets      Ticket[]               @relation("Assignee")
  defaultForQueues     Queue[]                @relation("QueueDefaultAssignee")
  messages             TicketMessage[]
  uploadedFiles        TicketAttachment[]
  historyEntries       TicketHistory[]
  notifications        Notification[]
  savedViews           SavedView[]
  ticketParticipations TicketParticipant[]
  mentionedInMessages  TicketMessageMention[]
  apiTokens            ApiToken[]
  createdTicketShares  TicketShare[]          @relation("TicketShareCreator")

  @@map("users")
}

// ============ better-auth 表（会话/凭据/验证）============
model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// 给 CLI、MCP 和自动化脚本使用的个人 API Token。
/// 完整密钥只在创建/轮换响应里出现，数据库仅保存 SHA-256 哈希。
model ApiToken {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  name       String
  tokenHash  String    @unique @map("token_hash")
  prefix     String
  scopes     String[]
  expiresAt  DateTime? @map("expires_at")
  lastUsedAt DateTime? @map("last_used_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([tokenHash])
  @@map("api_tokens")
}

/// 免登录查看工单公开讨论的分享链接。
/// 链接密钥只在创建时返回；数据库仅保存 SHA-256 哈希，泄露数据库不能还原链接。
model TicketShare {
  id          String    @id @default(cuid())
  ticketId    String    @map("ticket_id")
  createdById String    @map("created_by_id")
  label       String
  tokenHash   String    @unique @map("token_hash")
  expiresAt   DateTime? @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  ticket    Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  createdBy User   @relation("TicketShareCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([ticketId, revokedAt])
  @@index([tokenHash])
  @@map("ticket_shares")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@unique([providerId, accountId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

// better-auth two-factor 插件：密钥与恢复码由插件加密存储，业务代码不读取。
model TwoFactor {
  id                      String    @id @default(cuid())
  secret                  String
  backupCodes             String
  userId                  String    @unique
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean   @default(false)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime?

  @@map("twoFactor")
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique // requester / handler / supervisor / admin
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id   String @id @default(cuid())
  code String @unique // e.g. ticket:create, ticket:assign
  name String

  roles RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId String @map("user_id")
  roleId String @map("role_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ============ 队列 / 类型 / 分类 / 标签 ============
model Queue {
  id                String  @id @default(cuid())
  name              String  @unique
  description       String?
  defaultAssigneeId String? @map("default_assignee_id")

  defaultAssignee User?    @relation("QueueDefaultAssignee", fields: [defaultAssigneeId], references: [id])
  tickets         Ticket[]

  @@map("queues")
}

model TicketType {
  id             String @id @default(cuid())
  name           String @unique
  slaResponseMin Int    @default(60) @map("sla_response_min")
  slaResolveMin  Int    @default(1440) @map("sla_resolve_min")

  tickets Ticket[]

  @@map("ticket_types")
}

model Category {
  id       String  @id @default(cuid())
  name     String
  parentId String? @map("parent_id")

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  tickets  Ticket[]

  @@map("categories")
}

// ============ IDC 资产定位：机房 / 集群 ============
// 做成表而不是写死在前端：机房和集群会随业务扩，加一个不该要一次发版。
model Datacenter {
  id       String    @id @default(cuid())
  name     String    @unique
  clusters Cluster[]
  assets   Asset[]
  tickets  Ticket[]

  @@map("datacenters")
}

model Cluster {
  id           String  @id @default(cuid())
  name         String  @unique
  datacenterId String? @map("datacenter_id")

  datacenter Datacenter? @relation(fields: [datacenterId], references: [id])
  tickets    Ticket[]

  assets Asset[]

  @@map("clusters")
}

model Tag {
  id    String @id @default(cuid())
  name  String @unique
  color String @default("#888888")

  tickets TicketTag[]

  @@map("tags")
}

model TicketTag {
  ticketId String @map("ticket_id")
  tagId    String @map("tag_id")

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([ticketId, tagId])
  @@map("ticket_tags")
}

// ============ 工单主表（容器，不含正文）============
model Ticket {
  id                 String       @id @default(cuid())
  ticketNo           String       @unique @map("ticket_no")
  title              String
  requesterId        String       @map("requester_id")
  assigneeId         String?      @map("assignee_id")
  queueId            String?      @map("queue_id")
  typeId             String?      @map("type_id")
  categoryId         String?      @map("category_id")
  // IDC 算力租赁场景的定位信息，三项都选填：机房 / 集群 / 设备序列号
  datacenterId       String?      @map("datacenter_id")
  clusterId          String?      @map("cluster_id")
  serialNumber       String?      @map("serial_number")
  priority           Priority     @default(MEDIUM)
  status             TicketStatus @default(NEW)
  // ===== SLA 计时 =====
  // 计时从「建单」起算，不是从接手起算：没人接手恰恰是最该告警的情况。
  // 挂起期间不计时——挂起意味着与用户达成一致在等外部条件，这段时间
  // 不该算在处理时长里。实现方式是恢复时把暂停时长加回到两个截止时刻上。
  slaDueAt           DateTime?    @map("sla_due_at")
  firstResponseDueAt DateTime?    @map("first_response_due_at")
  firstResponseAt    DateTime?    @map("first_response_at")
  /**
   * 当前这次挂起的开始时刻；非挂起状态为空
   */
  holdStartedAt      DateTime?    @map("hold_started_at")
  /**
   * 累计挂起毫秒数，供报表算「真实处理时长」用
   */
  holdMs             Int          @default(0) @map("hold_ms")
  // 提单人的联系方式，选填。结构见 TicketContactDto：
  // { position?, phone, callTime, smsTime, emails[] }。
  // 时间/职位存的是枚举键而非展示文案——四种语言下文案会变，键不会
  contact            Json?
  extra              Json? // 预留自定义字段
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")
  closedAt           DateTime?    @map("closed_at")

  requester  User        @relation("Requester", fields: [requesterId], references: [id])
  assignee   User?       @relation("Assignee", fields: [assigneeId], references: [id])
  queue      Queue?      @relation(fields: [queueId], references: [id])
  type       TicketType? @relation(fields: [typeId], references: [id])
  category   Category?   @relation(fields: [categoryId], references: [id])
  datacenter Datacenter? @relation(fields: [datacenterId], references: [id])
  cluster    Cluster?    @relation(fields: [clusterId], references: [id])

  messages            TicketMessage[]
  attachments         TicketAttachment[]
  history             TicketHistory[]
  tags                TicketTag[]
  notifications       Notification[]
  participants        TicketParticipant[]
  shares              TicketShare[]
  assets              TicketAsset[]
  inventoryOperations InventoryOperation[]

  @@index([status])
  @@index([assigneeId])
  @@index([queueId])
  // 列表页的典型组合：按队列/处理人筛状态、按创建时间倒序翻页。
  // 单列索引只能服务一个维度，组合查询需逐行回表过滤。
  @@index([queueId, status, createdAt])
  @@index([assigneeId, status, createdAt])
  @@map("tickets")
}

// ============ 工单协作 ============
// 主处理人仍由 Ticket.assigneeId 唯一承载；此表仅记录协作/关注关系，不能稀释 SLA 责任。
model TicketParticipant {
  ticketId  String                @map("ticket_id")
  userId    String                @map("user_id")
  role      TicketParticipantRole @default(COLLABORATOR)
  createdAt DateTime              @default(now()) @map("created_at")
  addedById String                @map("added_by_id")

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([ticketId, userId])
  @@index([userId, role])
  @@map("ticket_participants")
}

// ============ 逐条消息 / 往来（正文在这里）============
model TicketMessage {
  id          String      @id @default(cuid())
  ticketId    String      @map("ticket_id")
  authorId    String      @map("author_id")
  type        MessageType @default(REPLY)
  isInternal  Boolean     @default(false) @map("is_internal")
  contentType String      @default("text/html") @map("content_type")
  body        String
  createdAt   DateTime    @default(now()) @map("created_at")

  ticket      Ticket                 @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author      User                   @relation(fields: [authorId], references: [id])
  attachments TicketAttachment[]
  mentions    TicketMessageMention[]

  // 复合索引覆盖「工单内消息按时间排序」；纯 ticketId 前缀查询同样命中
  @@index([ticketId, createdAt])
  @@map("ticket_messages")
}

// @ 提及独立落库：通知、审计和后续“提及我的消息”筛选不依赖解析富文本正文。
model TicketMessageMention {
  messageId String   @map("message_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  message TicketMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
  @@index([userId, createdAt])
  @@map("ticket_message_mentions")
}

// ============ 附件（object_key 指向 StorageService）============
model TicketAttachment {
  id         String   @id @default(cuid())
  ticketId   String?  @map("ticket_id") // 草稿附件（建单前上传）ticketId 暂为空，提交时关联
  messageId  String?  @map("message_id")
  fileName   String   @map("file_name")
  objectKey  String   @map("object_key")
  fileSize   Int      @map("file_size")
  mime       String
  uploaderId String   @map("uploader_id")
  createdAt  DateTime @default(now()) @map("created_at")

  ticket   Ticket?        @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  message  TicketMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)
  uploader User           @relation(fields: [uploaderId], references: [id])

  @@index([ticketId])
  // 上传配额按「上传者 + 时间窗口」统计，没有这个索引每次上传都要全表扫描
  @@index([uploaderId, createdAt])
  @@map("ticket_attachments")
}

/// 对象删除 outbox。
/// 业务记录（工单/消息/附件行）在数据库事务里删除时，把对象 key 一并写进来；
/// 后台任务按 nextAttemptAt 领取并重试 S3 删除，避免删除失败后永久丢失定位。
model AttachmentDeletionTask {
  id            String   @id @default(cuid())
  objectKey     String   @map("object_key")
  reason        String   @default("UNKNOWN")
  attempts      Int      @default(0)
  lastError     String?  @map("last_error")
  nextAttemptAt DateTime @default(now()) @map("next_attempt_at")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([nextAttemptAt])
  @@map("attachment_deletion_tasks")
}

// ============ 审计历史 ============
model TicketHistory {
  id        String        @id @default(cuid())
  ticketId  String        @map("ticket_id")
  /**
   * 为空表示系统自动操作（如 SLA 超时自动升级优先级），界面显示为「系统」
   */
  userId    String?       @map("user_id")
  action    HistoryAction
  field     String?
  oldValue  String?       @map("old_value")
  newValue  String?       @map("new_value")
  createdAt DateTime      @default(now()) @map("created_at")

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id])

  @@index([ticketId])
  @@map("ticket_history")
}

// ============ 通知 ============
model Notification {
  subjectKind String?
  subjectId   String?
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  ticketId    String?  @map("ticket_id")
  type        String
  title       String
  content     String?
  isRead      Boolean  @default(false) @map("is_read")
  createdAt   DateTime @default(now()) @map("created_at")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  ticket Ticket? @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  @@index([userId, isRead])
  @@map("notifications")
}

// ============ 保存筛选视图 ============
model SavedView {
  id         String  @id @default(cuid())
  userId     String  @map("user_id")
  name       String
  filterJson Json    @map("filter_json")
  isShared   Boolean @default(false) @map("is_shared")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("saved_views")
}

// ============ GreenStor COP: 组织、资产与库存 ============
enum AssetStatus {
  PENDING_REGISTRATION
  IN_STOCK
  IN_USE
  MAINTENANCE
  RETIRED
}

enum InventoryOperationType {
  RECEIVE
  ISSUE
  RETURN
  TRANSFER
  ADJUST
  REVERSAL
}

model Department {
  id         String       @id @default(cuid())
  name       String       @unique
  parentId   String?
  active     Boolean      @default(true)
  createdAt  DateTime     @default(now())
  parent     Department?  @relation("DepartmentTree", fields: [parentId], references: [id], onDelete: Restrict)
  children   Department[] @relation("DepartmentTree")
  users      User[]
  assets     Asset[]
  warehouses Warehouse[]

  @@map("departments")
}

model Asset {
  sourceStatus   String?
  ownerName      String?
  ownership      String               @default("UNCONFIRMED")
  rackName       String?
  rackUnit       String?
  sourceSystem   String?
  sourceRecordId String?
  sourceUrl      String?
  lastSyncedAt   DateTime?
  labelVerified  Boolean              @default(false)
  id             String               @id @default(cuid())
  code           String?              @unique
  name           String
  category       String?
  manufacturer   String?
  model          String?
  serialNumber   String?
  location       String?
  description    String?
  status         AssetStatus          @default(PENDING_REGISTRATION)
  custodianId    String?
  departmentId   String?
  datacenterId   String?
  clusterId      String?
  purchaseDate   DateTime?
  purchaseCost   Decimal?             @db.Decimal(14, 2)
  currency       String               @default("CNY")
  warrantyUntil  DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  custodian      User?                @relation(fields: [custodianId], references: [id], onDelete: SetNull)
  department     Department?          @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  datacenter     Datacenter?          @relation(fields: [datacenterId], references: [id], onDelete: Restrict)
  cluster        Cluster?             @relation(fields: [clusterId], references: [id], onDelete: Restrict)
  tickets        TicketAsset[]
  operations     InventoryOperation[]

  @@unique([sourceSystem, sourceRecordId])
  @@index([status, departmentId])
  @@index([serialNumber])
  @@map("assets")
}

model TicketAsset {
  ticketId  String
  assetId   String
  createdAt DateTime @default(now())
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@id([ticketId, assetId])
  @@index([assetId])
  @@map("ticket_assets")
}

model SparePart {
  id           String               @id @default(cuid())
  sku          String               @unique
  name         String
  category     String?
  manufacturer String?
  model        String?
  unit         String               @default("件")
  minimumStock Int                  @default(0)
  description  String?
  active       Boolean              @default(true)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  balances     StockBalance[]
  movements    StockMovement[]
  operations   InventoryOperation[]

  @@index([active, category])
  @@map("spare_parts")
}

model Warehouse {
  id           String          @id @default(cuid())
  code         String          @unique
  name         String
  location     String?
  departmentId String?
  active       Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  department   Department?     @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  balances     StockBalance[]
  movements    StockMovement[]

  @@map("warehouses")
}

model StockBalance {
  warehouseId String
  sparePartId String
  quantity    Int       @default(0)
  updatedAt   DateTime  @updatedAt
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  sparePart   SparePart @relation(fields: [sparePartId], references: [id], onDelete: Restrict)

  @@id([warehouseId, sparePartId])
  @@map("stock_balances")
}

model InventoryOperation {
  id             String                 @id @default(cuid())
  type           InventoryOperationType
  sparePartId    String
  actorId        String
  actorName      String
  idempotencyKey String                 @unique
  requestHash    String
  reason         String
  ticketId       String?
  assetId        String?
  reversesId     String?                @unique
  createdAt      DateTime               @default(now())
  sparePart      SparePart              @relation(fields: [sparePartId], references: [id], onDelete: Restrict)
  actor          User                   @relation(fields: [actorId], references: [id], onDelete: Restrict)
  ticket         Ticket?                @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  asset          Asset?                 @relation(fields: [assetId], references: [id], onDelete: Restrict)
  reverses       InventoryOperation?    @relation("InventoryReversal", fields: [reversesId], references: [id], onDelete: Restrict)
  reversedBy     InventoryOperation?    @relation("InventoryReversal")
  movements      StockMovement[]

  @@index([sparePartId, createdAt])
  @@index([assetId])
  @@map("inventory_operations")
}

model StockMovement {
  id          String             @id @default(cuid())
  operationId String
  warehouseId String
  sparePartId String
  delta       Int
  before      Int
  after       Int
  createdAt   DateTime           @default(now())
  operation   InventoryOperation @relation(fields: [operationId], references: [id], onDelete: Restrict)
  warehouse   Warehouse          @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  sparePart   SparePart          @relation(fields: [sparePartId], references: [id], onDelete: Restrict)

  @@index([warehouseId, sparePartId, createdAt])
  @@map("stock_movements")
}

// Public platform infrastructure; controlled adapters enforce subject existence
// and module authorization. Subjects are archived, not deleted.
model BusinessActivity {
  id        String   @id @default(cuid())
  kind      String
  entityId  String
  action    String
  actorId   String?
  actorName String
  before    Json?
  after     Json?
  createdAt DateTime @default(now())
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([kind, entityId, createdAt])
  @@map("business_activities")
}

model BusinessAttachment {
  id           String   @id @default(cuid())
  kind         String
  entityId     String
  fileName     String
  objectKey    String   @unique
  fileSize     Int
  mime         String
  uploaderId   String?
  uploaderName String
  createdAt    DateTime @default(now())
  uploader     User?    @relation(fields: [uploaderId], references: [id], onDelete: SetNull)

  @@index([kind, entityId])
  @@map("business_attachments")
}

model AssetImportBatch {
  id          String   @id
  actorId     String
  actorName   String
  requestHash String
  result      Json
  createdAt   DateTime @default(now())

  @@map("asset_import_batches")
}

// Optional external identity; no external password is stored in Assay.
model SambaIdentity {
  userId       String @id
  adObjectId   String @unique
  domain       String
  accountName  String
  linkedBy     String
  linkedAt     DateTime @default(now())
  @@map("samba_identities")
}

// Optional directory authentication; business records continue to reference User.id.
// Passwords and password hashes from AD are never stored here.
model DirectoryIdentity {
  userId        String   @id @map("user_id")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerId    String   @map("provider_id")
  objectId      String   @map("object_id")
  accountName   String   @map("account_name")
  groupSids     String[] @default([]) @map("group_sids")
  roleNames     String[] @default([]) @map("role_names")
  checkedAt     DateTime @default(now()) @map("checked_at")
  @@unique([providerId, objectId])
  @@map("directory_identities")
}

model DirectoryGroupRole {
  providerId String @map("provider_id")
  groupSid   String @map("group_sid")
  groupName  String @map("group_name")
  roleName   String @map("role_name")
  @@id([providerId, groupSid, roleName])
  @@map("directory_group_roles")
}

model SambaOperation {
  id          String @id
  actorId     String
  actorName   String
  action      String
  requestHash String
  metadata    Json
  state       String @default("pending")
  result      Json?
  // Legacy v1 hash retained for compatibility; integrity is tracked by SambaAuditEvent.
  chainHash   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([createdAt])
  @@map("samba_operations")
}


model SambaAuditEvent {
  sequence     BigInt   @id @default(autoincrement())
  operationId  String   @map("operation_id")
  event        String
  snapshot     Json
  previousHash String   @map("previous_hash")
  chainHash    String   @map("chain_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  @@index([operationId, sequence])
  @@map("samba_audit_events")
}
