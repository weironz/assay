# Reference only. Taskfile DOES NOT load .env.local-ci automatically.
# Export variables in your shell or bind them through the environment's secret
# manager. Never commit actual values or put tokens on the command line.
#
# Publication secrets:
# ASSAY_RELEASE_GITHUB_TOKEN (also accepts GH_TOKEN/GITHUB_TOKEN)
# DOCKERHUB_TOKEN
# DOCKERHUB_USERNAME=willdockerhub
#
# Nonsecret build settings:
# DOCKERHUB_NAMESPACE=willdockerhub
# GITHUB_REPOSITORY=weironz/assay
# LOCAL_CI_STATE_DIR=/private/persistent/assay-ci
# LOCAL_CI_PROXY_CA=/absolute/path/to/proxy-ca.pem
# CARGO=cargo
# CARGO_HOME=/absolute/path/to/cargo-cache
# RUSTUP_HOME=/absolute/path/to/rustup
#
# Explicit Ansible target (same names as Cormex, different app directory):
# DEPLOY_HOST=your-production-host
# DEPLOY_USER=your-ssh-user
# DEPLOY_DIR=/absolute/path/to/existing/assay
# DEPLOY_PORT=22
# DEPLOY_SSH_KEY=/private/path/id_ed25519
# DEPLOY_KNOWN_HOSTS=/private/path/verified_known_hosts
# DEPLOY_SSH_CONFIG=/private/path/ssh_config
# DEPLOY_BECOME=false
# DEPLOY_OFFLINE=false
# Optional secret variables: DEPLOY_PASSWORD, DEPLOY_BECOME_PASSWORD
# LOCAL_CI_UPGRADE_BACKUP_DIR=/private/backup/outside/checkout
# ASSAY_ACTIONS_REF=main
