# Optional local settings. Copy to .env.local-ci; never commit credentials.
# Authenticate normally with `gh auth login` and `docker login` before publishing.
# Alternatively bind these tokens as managed environment secrets, not in this file:
# ASSAY_RELEASE_GITHUB_TOKEN: GitHub token with contents write access to the release repository
# DOCKERHUB_TOKEN: Docker Hub token with read/write access to the image repositories
# The username is not a secret; it can differ from DOCKERHUB_NAMESPACE (organization).
# DOCKERHUB_USERNAME=willdockerhub
# Optional fallback: select a dedicated local `gh auth login` credential directory.
# Only the path is saved here; the GitHub CLI stores the credential outside the repo.
# ASSAY_RELEASE_GH_CONFIG_DIR=/absolute/path/to/private-gh-config
# Task's VERSION defaults to package.json; all product versions must match.
# DOCKERHUB_NAMESPACE=willdockerhub
# GITHUB_REPOSITORY=weironz/assay
# LOCAL_CI_STATE_DIR=/absolute/path/to/local-ci-output
# LOCAL_CI_PROXY_CA=/absolute/path/to/proxy-ca.pem
# CARGO=cargo
# RUSTUP=rustup
# CARGO_HOME=/absolute/path/to/cargo-cache
# RUSTUP_HOME=/absolute/path/to/rustup

# Only deploy:production reads these settings. ci/publish/release never use SSH.
# LOCAL_CI_DEPLOY_HOST=your-production-host
# LOCAL_CI_DEPLOY_USER=your-ssh-user
# LOCAL_CI_DEPLOY_DIR=/data/assay
# LOCAL_CI_DEPLOY_PORT=22
# LOCAL_CI_SSH_CONFIG=/absolute/path/to/ssh-config
# LOCAL_CI_UPGRADE_BACKUP_DIR=/private/path/outside/the/repository
# LOCAL_CI_DEPLOY_OFFLINE=true
