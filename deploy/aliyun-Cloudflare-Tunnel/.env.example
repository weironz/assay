# 阿里云 Cloudflare Tunnel 的 Assay 应用环境。安装时与 docker-compose.yaml 放在同一目录。
# 只配置主域名，不需要 PUBLIC_URL；容器中的 URL 由 Compose 推导。
PUBLIC_DOMAIN=assay.example.com

# 登录请求允许的精确来源（逗号分隔），由本文件配置，不在 Compose 写死。
AUTH_TRUST_ORIGINS=https://${PUBLIC_DOMAIN}

# 必须与 cloudflared 的 CLOUDFLARED_NETWORK 一致。
# 现有生产可继续使用 traefik-network；新安装默认使用 assay-tunnel。
CLOUDFLARED_NETWORK=assay-tunnel

# ---------- 镜像 ----------
# 默认从阿里云 ACR 拉取（国内快）；想用 Docker Hub 就改成 REGISTRY=willdockerhub
# REGISTRY=registry.cn-shenzhen.aliyuncs.com/willspace
IMAGE_TAG=latest
# 现有部署升级配置时，保留正在运行的基础镜像完整引用，避免同名标签漂移。
# POSTGRES_IMAGE=postgres@sha256:<current-image-digest>
# REDIS_IMAGE=redis@sha256:<current-image-digest>
# RUSTFS_IMAGE=rustfs/rustfs@sha256:<current-image-digest>

# ---------- PostgreSQL（务必改强密码）----------
POSTGRES_USER=assay
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=assay

# ---------- 对象存储 RustFS（务必改强密钥）----------
# 模板固定 RustFS 1.0.0。现有 rustfs-data 卷若由更新的 latest 写入，
# 切换镜像前须先备份并在副本上验证读写兼容；不要直接对生产数据降级。
# 应用 CI 发布只更新 api/web；RustFS 升级或降级须单独安排。
S3_BUCKET=assay-attachments
S3_REGION=us-east-1
S3_ACCESS_KEY=CHANGE_ME_access_key
S3_SECRET_KEY=CHANGE_ME_secret_key
S3_FORCE_PATH_STYLE=true

# ---------- 认证（务必改成长随机串：openssl rand -base64 32）----------
AUTH_SECRET=CHANGE_ME_long_random_secret
# 特权账号 MFA：默认 optional。先让管理员/主管完成绑定并验证登录，再分阶段切到 enforce。
PRIVILEGED_MFA_MODE=optional

# ---------- 初始管理员 ----------
# 仅首次启动、库里还没有该账号时创建。之后改这里不会改已存在账号的密码——
# 要改密码请登录后在界面上改，或用管理员重置接口。
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_admin_password
ADMIN_NAME=系统管理员

# ---------- 邮件发送（可选）----------
# 不配则邮箱验证、找回密码等功能不可用，其余功能不受影响。
# MAIL_PROVIDER: aliyun | smtp | none
#   留空自动判断：有 ALIYUN_DM_ACCESS_KEY_ID 走 aliyun，有 SMTP_HOST 走 smtp，都没有则不发信
# MAIL_PROVIDER=aliyun

# --- 阿里云邮件推送 DirectMail ---
# ALIYUN_DM_ACCESS_KEY_ID=
# ALIYUN_DM_ACCESS_KEY_SECRET=
# ALIYUN_DM_ACCOUNT=noreply@mail.example.com
# ALIYUN_DM_REGION=cn-hangzhou
# ALIYUN_DM_FROM_ALIAS=工单管理系统

# --- 通用 SMTP ---
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=工单管理系统 <noreply@example.com>

# 是否强制邮箱验证后才能登录（默认：配了发信服务就开启）
# 内网自建、没有发信服务时建议显式关掉，否则新注册用户无法登录
# REQUIRE_EMAIL_VERIFICATION=false

# ---------- 其他（一般不用改）----------
# 附件上传中转目录，留空用系统临时目录。上传期间会占盘：并发数 × 单文件大小
# UPLOAD_TMP_DIR=
