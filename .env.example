# ===== 通用 =====
NODE_ENV=development

# ===== PostgreSQL =====
POSTGRES_USER=assay
POSTGRES_PASSWORD=assay_dev_pwd
POSTGRES_DB=assay
POSTGRES_PORT=5432
# api 容器内连接串（host 用服务名 postgres）
DATABASE_URL=postgresql://assay:assay_dev_pwd@postgres:5432/assay?schema=public

# ===== Redis（会话 + BullMQ）=====
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# ===== 对象存储（StorageService）=====
# 可选 local | s3 ；s3 指向 RustFS
STORAGE_DRIVER=s3
STORAGE_LOCAL_DIR=/data/attachments
S3_ENDPOINT=http://rustfs:9000
S3_REGION=us-east-1
S3_BUCKET=assay-attachments
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin_dev_pwd
S3_FORCE_PATH_STYLE=true

# ===== 认证（better-auth）=====
# 会话/加密不可复用的强随机密钥；生产环境缺失、过短（<32 字符）或为公开占位值时
# API 拒绝启动——复制本文件后不填新值起不来，请用 openssl rand -base64 48 生成
# AUTH_SECRET=
AUTH_BASE_URL=http://localhost:3000
AUTH_TRUST_ORIGINS=http://localhost:5173
# 公开自助注册默认关闭；管理员创建账号和首次管理员自举不受影响
AUTH_ALLOW_REGISTRATION=false
# ===== 企业 OIDC 登录（可选；配置只在后端，不要加 VITE_ 前缀）=====
OIDC_ENABLED=false
# Keycloak 示例：https://sso.example.com/realms/company
# OIDC_ISSUER_URL=
# OIDC_CLIENT_ID=assay
# OIDC_CLIENT_SECRET=
# OIDC_DISPLAY_NAME=企业账号
# 新身份首次登录创建本地「提单人」；false 时仅允许已关联的账号登录
# OIDC_AUTO_PROVISION=true
# 可选：限制已验证的邮箱域，逗号分隔；留空接受此 IdP 的已验证邮箱
# OIDC_EMAIL_DOMAINS=example.com
# OIDC_TOKEN_AUTH_METHOD=client_secret_basic
# 仅非生产环境的 localhost/127.0.0.1 IdP 可显式启用 HTTP
# OIDC_ALLOW_HTTP=false

# ===== 公司 AD 登录（可选，独立于 Samba 管理/文件模块；默认仍用本地账号）=====
DIRECTORY_AUTH_ENABLED=false
# DIRECTORY_LDAP_URL=ldaps://dc.example.com:636
# DIRECTORY_DOMAIN=example.com
# DIRECTORY_NETBIOS_DOMAIN=EXAMPLE
# DIRECTORY_BASE_DN=DC=example,DC=com
# 使用专用的只读目录账号；密码和 CA 通过只读文件挂载到 API 容器。
# DIRECTORY_BIND_DN=CN=assay-reader,OU=Service Accounts,DC=example,DC=com
# DIRECTORY_BIND_PASSWORD_FILE=/secrets/directory-password
# DIRECTORY_CA_FILE=/secrets/directory-ca.crt
# DIRECTORY_DISPLAY_NAME=公司账号
# DIRECTORY_AUTO_PROVISION=true
# AD 组 → 业务角色映射在「平台管理 → 身份与访问」配置。
# 在 IdP 注册精确回调：${AUTH_BASE_URL}/api/auth/oidc/callback
# 启动时自动创建的管理员账号
# 生产环境必须显式设置强密码，缺失时 API 拒绝启动；
# 本地开发不设置时会生成一次性随机密码并打印在 API 启动日志中
ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=please_set_a_strong_password
ADMIN_NAME=系统管理员

# ===== 端口 =====
API_PORT=3000
WEB_PORT=5173
ADMINER_PORT=8080
# 注意：若主机 9000/9001 已被其他 RustFS/MinIO 占用，改成空闲端口即可（内部走 rustfs:9000 不受影响）
RUSTFS_PORT=9100
RUSTFS_CONSOLE_PORT=9101

# ===== 邮件通知（可选，配置 SMTP_HOST 后启用；不配则只发站内信）=====
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=工单系统 <no-reply@example.com>
# 邮件里"查看工单"链接的前端地址（默认取 AUTH_TRUST_ORIGINS 第一个）
# APP_URL=http://localhost:5173

# ===== 前端 =====
VITE_API_BASE_URL=http://localhost:3000

# 可选员工文件模块：需同时启用 Samba 集成，详见 docs/samba/05-员工文件模块.md
FILES_ENABLED=false
FILES_GATEWAY_URL=http://file-gateway:8081
FILES_GATEWAY_TOKEN_FILE=/secrets/files-token
