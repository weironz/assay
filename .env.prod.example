# ===== Assay 生产环境变量模板 =====
# 复制为 .env 再填真实值：cp .env.prod.example .env
# 部署步骤见 docs/05-部署文档.md

# ---------- 对外访问地址（两种场景只需填一个）----------
# 场景 1（IP 直连）：填浏览器实际访问的地址，含协议与端口
#   PUBLIC_URL=http://192.168.1.10:8088
# 场景 2（Traefik 域名）：填 https 域名，并同时设置 PUBLIC_DOMAIN
#   PUBLIC_URL=https://tickets.example.com
#   PUBLIC_DOMAIN=tickets.example.com
#
# ⚠️ PUBLIC_URL 必须与用户地址栏里的地址完全一致（协议、域名、端口都算）。
#    它同时是登录会话的签发地址和 CORS 白名单，写错会导致「密码正确但登不进去」。
PUBLIC_URL=http://localhost:8088

# 仅场景 2 需要：Traefik 路由用的域名（不带协议）
# PUBLIC_DOMAIN=tickets.example.com

# 仅场景 1 需要：宿主机映射端口，默认 8088
WEB_PORT=8088

# ---------- 镜像 ----------
# 默认从阿里云 ACR 拉取（国内快）；想用 Docker Hub 就改成 REGISTRY=willdockerhub
# REGISTRY=registry.cn-shenzhen.aliyuncs.com/willspace
IMAGE_TAG=latest

# ---------- PostgreSQL（务必改强密码）----------
POSTGRES_USER=assay
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=assay

# ---------- 对象存储 RustFS（务必改强密钥）----------
S3_BUCKET=assay-attachments
S3_REGION=us-east-1
S3_ACCESS_KEY=CHANGE_ME_access_key
S3_SECRET_KEY=CHANGE_ME_secret_key
S3_FORCE_PATH_STYLE=true

# ---------- 认证（务必改成长随机串：openssl rand -base64 32）----------
AUTH_SECRET=CHANGE_ME_long_random_secret

# ---------- 初始管理员 ----------
# 仅首次启动、库里还没有该账号时创建。之后改这里不会改已存在账号的密码——
# 要改密码请登录后在界面上改，或用管理员重置接口。
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_admin_password
ADMIN_NAME=系统管理员

# ---------- 邮件发送（可选）----------
# 不配则邮箱验证、找回密码等功能不可用，其余功能不受影响。
# MAIL_PROVIDER: aliyun | smtp | none
#   留空自动判断：有 ALIYUN_DM_ACCESS_KEY_ID 走 aliyun，有 SMTP_HOST 走 smtp，都没有则不发信
# MAIL_PROVIDER=aliyun

# --- 阿里云邮件推送 DirectMail ---
# ALIYUN_DM_ACCESS_KEY_ID=
# ALIYUN_DM_ACCESS_KEY_SECRET=
# ALIYUN_DM_ACCOUNT=noreply@mail.example.com
# ALIYUN_DM_REGION=cn-hangzhou
# ALIYUN_DM_FROM_ALIAS=工单管理系统

# --- 通用 SMTP ---
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=工单管理系统 <noreply@example.com>

# 是否强制邮箱验证后才能登录（默认：配了发信服务就开启）
# 内网自建、没有发信服务时建议显式关掉，否则新注册用户无法登录
# REQUIRE_EMAIL_VERIFICATION=false

# ---------- 其他（一般不用改）----------
# 附件上传中转目录，留空用系统临时目录。上传期间会占盘：并发数 × 单文件大小
# UPLOAD_TMP_DIR=
