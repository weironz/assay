# syntax=docker/dockerfile:1
ARG LINUX_BUILDER=rust:1.99-alpine

FROM ${LINUX_BUILDER} AS linux-builder
WORKDIR /source
COPY Cargo.toml Cargo.lock ./
COPY src ./src
RUN --mount=type=secret,id=proxy_ca \
    --mount=type=cache,id=assay-rust-registry,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,id=assay-cli-musl-target,target=/source/target,sharing=locked \
    if [ -f /run/secrets/proxy_ca ]; then export CARGO_HTTP_CAINFO=/run/secrets/proxy_ca SSL_CERT_FILE=/run/secrets/proxy_ca; fi; \
    cargo build --locked --release \
    && mkdir -p /out && cp target/release/assay /out/assay

FROM scratch AS linux-export
COPY --from=linux-builder /out/assay /assay-x86_64-unknown-linux-musl
