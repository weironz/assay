# syntax=docker/dockerfile:1
ARG LINUX_BUILDER=rust:1.99-alpine

FROM ${LINUX_BUILDER} AS linux-builder
WORKDIR /source
COPY Cargo.toml Cargo.lock ./
COPY src ./src
RUN --mount=type=secret,id=proxy_ca \
    if [ -f /run/secrets/proxy_ca ]; then export CARGO_HTTP_CAINFO=/run/secrets/proxy_ca SSL_CERT_FILE=/run/secrets/proxy_ca; fi; \
    cargo build --locked --release

FROM scratch AS linux-export
COPY --from=linux-builder /source/target/release/assay /assay-x86_64-unknown-linux-musl
